# Staging: one password for the whole site, and no indexing. The container healthcheck path stays open.
# The hash is bcrypt (caddy hash-password). It comes from the server .env file, never from git (G9).
@protected not path /healthz
basic_auth @protected {
	staging {$STAGING_BASIC_AUTH_HASH}
}
header X-Robots-Tag "noindex, nofollow"
