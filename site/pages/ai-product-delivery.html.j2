{% extends "base.html.j2" %}
{% block h1 %}<h1>From AI idea to a feature customers use.</h1>{% endblock %}
{% block lead %}Many AI ideas stall between a demo and a release. We help you choose the use case, build it and launch it.{% endblock %}
{% block content %}
  <section class="ex-section">
    <div class="ex-wrap">
      <h2>Problems we meet often.</h2>
      <div class="ex-pillars">
        <div class="ex-pillar"><h3>No clear use case</h3><p>The team has many ideas and no way to rank them by value and risk.</p></div>
        <div class="ex-pillar"><h3>A demo that cannot ship</h3><p>The prototype works on a laptop. It has no tests, no review path and no owner.</p></div>
        <div class="ex-pillar"><h3>No senior product lead</h3><p>Engineers build the feature. Nobody owns the result for the customer.</p></div>
      </div>
    </div>
  </section>

  <section class="ex-section">
    <div class="ex-wrap">
      <h2>Three ways to engage.</h2>
      <div class="ex-cards">
        <article class="ex-card"><h3>AI opportunity sprint</h3><p>Two weeks. You get a ranked list of use cases, one chosen, and a plan to build it.</p></article>
        <article class="ex-card"><h3>Fractional AI product leadership</h3><p>A senior product lead for a few days each week, from use case to launch.</p></article>
        <article class="ex-card"><h3>Build support</h3><p>Senior help for your team on design, delivery governance and release.</p></article>
      </div>
    </div>
  </section>
{% endblock %}
