{% extends "base.html.j2" %}
{% block h1 %}<h1 class="ex-display">AI you can {% if ready('findings-sourced') %}{{ backed('findings-sourced', 'audit.') }}{% else %}audit.{% endif %}</h1>{% endblock %}
{% block lead %}We modernise legacy software and ship AI products.{% endblock %}
{% block content %}
  <section class="ex-section" id="capabilities">
    <div class="ex-wrap">
      <h2>Three ways we work with you.</h2>
      <div class="ex-cards">
        <article class="ex-card"><h3>Legacy Modernisation</h3><p>Turn code that nobody understands into a written specification. Then modernise in safe stages.</p><a class="ex-link--go" href="/legacy-modernisation/">Request an assessment</a></article>
        <article class="ex-card"><h3>AI Product Delivery</h3><p>Go from an AI idea to a feature your customers use, with senior product leadership when you need it.</p><a class="ex-link--go" href="/ai-product-delivery/">Book a call</a></article>
        <article class="ex-card ex-card--early"><h3>Exaktiv Product Data</h3><p>Structured product data from supplier datasheets. Each value is designed to link to its page. In early access.</p><a class="ex-link--go" href="/product-data/">Join early access</a></article>
      </div>
    </div>
  </section>

  <section class="ex-section" id="pillars">
    <div class="ex-wrap">
{% if ready('findings-sourced') or ready('in-region') or ready('no-training') or ready('human-approval') %}      <h2>The rules that hold every engagement.</h2>
      <div class="ex-pillars">
{% if ready('findings-sourced') %}        <div class="ex-pillar"><h3>Traceable</h3><p>{{ backed('findings-sourced', 'Every finding links to its source.') }} A file and a line in code, or a page and an area in a document.</p></div>
{% endif %}{% if ready('in-region') %}        <div class="ex-pillar"><h3>In-region</h3><p>{{ backed('in-region', 'AI processing stays in the client’s region.') }} EU data stays in the EU. India data stays in India. There is no fallback to another region.</p></div>
{% endif %}{% if ready('no-training') %}        <div class="ex-pillar"><h3>Private</h3><p>{{ backed('no-training', 'We never train models on a client’s code or data.') }} One client’s data never helps another client.</p></div>
{% endif %}{% if ready('human-approval') %}        <div class="ex-pillar"><h3>Human-approved</h3><p>{{ backed('human-approval', 'No change, release or decision happens without a human approval.') }}</p></div>
{% endif %}      </div>
{% endif %}
    </div>
  </section>

  <section class="ex-section" id="how">
    <div class="ex-wrap">
      <h2>Assess, pilot, modernise.</h2>
      <ol class="ex-steps">
        <li><h3>Assess</h3><p>Three to four weeks at a fixed price. A written specification, a system map, a risk register and a roadmap.</p></li>
        <li><h3>Pilot</h3><p>One module end to end, with tests that compare the old and the new behaviour.</p></li>
        <li><h3>Modernise</h3><p>Scale the method module by module, with your team.</p></li>
      </ol>
      <p class="ex-measure">{{ backed('team-experience', '26+ years of combined experience') }} in product leadership and enterprise architecture.</p>
    </div>
  </section>
{% endblock %}
