[Unit]
Description=Exaktiv site form job: retention (Deletes enquiries after 6 months (W-G4))
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
TimeoutStartSec=300
Restart=on-failure
RestartSec=300
User=deploy
# $$ is a literal dollar sign for systemd. The job reads its secrets from Doppler inside the container.
ExecStart=/bin/bash -c 'cd /opt/stack/exaktiv-site && IMAGE_TAG=$$(cat .current) docker compose --env-file .env --profile jobs run --rm -T --no-deps jobs retention'
